{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 5 minutes, sends queued customer messages from the outbox.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "message_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep_outbox": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processMessageOutbox",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Process message outbox",
            "description": "Send queued messages"
          }
        }
      }
    ]
  },
  "name": "Message Sweep"
}